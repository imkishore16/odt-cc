#usda 1.0
(
    defaultPrim = "World"
    framesPerSecond = 4
    metersPerUnit = 1
    timeCodesPerSecond = 4
    upAxis = "Z"
)

def Xform "World" (
    customData = {
        dictionary odtcc = {
            string venue = "LA Memorial Coliseum / Exposition Park (schematic demo slice)"
        }
    }
)
{
    def Cube "Ground"
    {
        color3f[] primvars:displayColor = [(0.25, 0.27, 0.3)]
        double size = 1
        float3 xformOp:scale = (1400, 1400, 1)
        double3 xformOp:translate = (0, 0, -0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 1000
        float3 xformOp:rotateXYZ = (-45, 0, 30)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 150
    }

